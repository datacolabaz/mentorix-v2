# Lokal: öz PostgreSQL URL-iniz və ya Railway → Postgres → Variables → DATABASE_URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mentorix
JWT_SECRET=your_super_secret_key_min_32_chars_recommended
PORT=3000
NODE_ENV=production
FRONTEND_URL=https://frontend.example
FRONTEND_BASE_URL=https://mentorix.example
SMS_LOGIN=your_sendsms_login
SMS_PASSWORD=your_sendsms_password
SMS_TITLE=Mentorix

# Resend — transactional email (signup verify, password reset, instructor reminders, …)
# REQUIRES USER ACTION: add + verify the sending domain in https://resend.com/domains
# then use an address on that domain below (product brand: mentorix.io).
RESEND_API_KEY=
VERIFY_EMAIL_FROM=Mentorix <notifications@mentorix.io>
# Optional alias (same value as VERIFY_EMAIL_FROM if set):
# EMAIL_FROM=Mentorix <notifications@mentorix.io>
# Optional: where the verification link points.
# Default uses FRONTEND_BASE_URL (or FRONTEND_URL) + /verify-email?token=...
EMAIL_VERIFICATION_BASE_URL=
EMAIL_VERIFICATION_TTL_MINUTES=60

# WhatsApp Cloud API (Meta) — konfiqurasiya olunmayıbsa bildirişlər SMS ilə gedir
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_API_VERSION=v25.0
#
# Prod (recipient siyahısı OLMADAN): WhatsApp Manager-də təsdiqlənmiş şablon adı
# Kütləvi bildiriş üçün məs: body = "Mentorix: {{1}}"
# WHATSAPP_TEMPLATE_NAME=mentorix_bildiris
# WHATSAPP_TEMPLATE_LANGUAGE=en_US
#
# İmtahan bildirişi (4 parametr: ad, imtahan, tarix, dəqiqə) — opsional, yoxdursa ümumi şablon
# WHATSAPP_EXAM_TEMPLATE_NAME=mentorix_exam

# Payriff (plan ödənişi) — merchant panelindən secret; Authorization header kimi göndərilir
PAYRIFF_SECRET_KEY=
# Applications səhifəsindəki Merchant ID (ES...); create order üçün lazımdır
PAYRIFF_MERCHANT_ID=
# PAYRIFF_API_SECRET və ya PAYRIFF_KEY alternativ adlardır (biri kifayətdir)
# PAYRIFF_BASE_URL=https://api.payriff.com/api/v3
# PAYRIFF_CALLBACK_URL=https://api.example.com/api/billing/payriff/return
# PAYRIFF_CALLBACK_TOKEN=təsadüfi_uzun_string
# PAYRIFF_PRORATION=1

# Partner / Referral (default enabled). Set 0 to disable.
# PARTNER_PROGRAM_ENABLED=1
# New instructor trial days (existing mid-trial users keep their period_end):
# TRIAL_DURATION_DAYS=21

# OpenAI — only used as fallback for assignment AI suggest when Anthropic is unset
# (university scraper still uses OpenAI separately)
OPENAI_API_KEY=
# OPENAI_ASSIGNMENT_MODEL=gpt-4o-mini
# OPENAI_UNIVERSITY_SCRAPER_MODEL=gpt-4o-mini
# UNIVERSITY_SCRAPER_AUTO_APPROVE=false
# UNIVERSITY_SCRAPER_BATCH_LIMIT=3

# Anthropic Claude — AI question generation + grading (preferred)
# Never expose these to the frontend.
ANTHROPIC_API_KEY=
# Question gen: Haiku 4.5 class (cost-efficient). Alias or dated ID OK.
AI_QUESTION_MODEL=claude-haiku-4-5
# Grading / assignment AI suggest: higher-quality Sonnet class
AI_GRADING_MODEL=claude-sonnet-5
# Legacy aliases (still honored if AI_* unset):
# ANTHROPIC_GENERATION_MODEL=claude-haiku-4-5
# ANTHROPIC_OPEN_GRADING_MODEL=claude-sonnet-5
# ANTHROPIC_GENERATION_TIMEOUT_MS=60000
# ANTHROPIC_OPEN_GRADING_TIMEOUT_MS=45000
# ANTHROPIC_GENERATION_MAX_TOKENS=4096
# GENERATION_RATE_LIMIT_PER_HOUR=20
# ANTHROPIC_MENTOR_MODEL=claude-sonnet-5

# LiveKit Cloud — Mentorix Live video otaqları
# https://cloud.livekit.io → API Keys
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_WS_URL=wss://your-project.livekit.cloud

# Google Sign-In (ID token) — existing
GOOGLE_CLIENT_ID=
# Optional verify timeout ms
# GOOGLE_VERIFY_TIMEOUT_MS=15000

# Google Meet / Calendar OAuth (Phase 1 BYO Meet)
# REQUIRES USER ACTION: Google Cloud Console → APIs & Services
# 1) Enable "Google Calendar API"
# 2) OAuth consent screen: add scope calendar.events (+ openid/email/profile)
# 3) Credentials → OAuth 2.0 Web client:
#    - Authorized redirect URI = GOOGLE_MEET_REDIRECT_URI below
# You may reuse the same Web client as Sign-In (add Client Secret + Calendar scope)
# or create a dedicated Meet client via GOOGLE_MEET_CLIENT_ID / GOOGLE_MEET_CLIENT_SECRET.
GOOGLE_CLIENT_SECRET=
# GOOGLE_MEET_CLIENT_ID=
# GOOGLE_MEET_CLIENT_SECRET=
GOOGLE_MEET_REDIRECT_URI=https://api.example.com/api/teacher-connections/google_meet/callback
# Optional: public API base used to derive redirect if GOOGLE_MEET_REDIRECT_URI unset
# API_PUBLIC_URL=https://api.example.com

# AES-256-GCM key for encrypting provider OAuth tokens at rest (32 bytes).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PROVIDER_TOKEN_ENCRYPTION_KEY=

# Tələbəyə yeni tapşırıq e-poçtu (Resend — VERIFY_EMAIL_FROM ilə eyni göndərən)
# RESEND_API_KEY= artıq yuxarıda
# FRONTEND_BASE_URL=https://edupanel.az

# Yarımçıq müəllim qeydiyyatı xatırlatması
# Default cascade: INSTRUCTOR_COMPLETE_PROFILE_FROM → VERIFY_EMAIL_FROM → EMAIL_FROM
# → Mentorix <notifications@mentorix.io>
# INSTRUCTOR_COMPLETE_PROFILE_FROM=Mentorix <notifications@mentorix.io>
